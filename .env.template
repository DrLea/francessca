# ---------------------------------------------------------------------------
# Francesca - Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://francessca:francessca@db:5432/francessca

# --- JWT ---
# Generate a strong secret, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Redis (cache + rate limiting) ---
REDIS_URL=redis://redis:6379/0

# --- Anthropic (OPTIONAL fallback, development only) ---
# Francesca runs on its own self-hosted models (AI_PROVIDER=local below).
# Only set these if you deliberately switch AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP (transactional email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@francessca.app

# --- URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- App ---
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Francesca is free for people. This is only a hidden fair-use cap against
# abuse: tokens per user per rolling 24 hours. Admins can override per user.
FAIR_USE_DAILY_TOKENS=200000
# Bootstrap admin (created on first startup if it does not exist)
# --- Lawyer portal ---
# Orders a newly registered lawyer can accept for free. After that they see
# a "contact us" screen until you unlock more from /admin/lawyers.
LAWYER_FREE_ORDERS=3
# Shown on that screen; lawyer sign-ups and feedback are mailed here too.
# Falls back to ADMIN_EMAIL. Emails are only sent when SMTP_HOST is set.
SUPPORT_EMAIL=

ADMIN_EMAIL=
ADMIN_PASSWORD=
# Max upload size in bytes (25 MB)
MAX_UPLOAD_SIZE=26214400
# Directory where uploaded files are stored
UPLOAD_DIR=/data/uploads
# Seed the lawyer directory with fictional sample data on first startup
# (lets the directory/search UI work before you run the real scraper).
# Set to false once you're syncing real data.
USE_FAKE_LAWYERS_DB=true

# --- Model provider ---
# "local" (default) talks to our own OpenAI-compatible model server --
# Ollama, llama.cpp or vLLM on our machine in Germany -- so no case data is
# sent to a third-party AI service. "anthropic" is an opt-in fallback. From inside Docker, localhost is the container, so use
# host.docker.internal to reach Ollama on the host:
#   AI_PROVIDER=local
#   LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
#   LOCAL_AI_MODEL=qwen2.5:7b
AI_PROVIDER=local
LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_AI_MODEL=qwen2.5:7b

# --- Desktop (offline) builds ---
# Where the built desktop apps can be downloaded. Read at request time by
# GET /public/downloads, so publishing a release is a change here plus
# `docker compose restart backend` -- no frontend rebuild. The landing page
# hides the download section entirely while these are empty.
#
# The executables are unsigned, so publish the checksums too: a visitor can
# then verify what they got.
#   Windows:  certutil -hashfile Francesca.exe SHA256
#   Linux:    sha256sum Francesca
# Serve the builds from this deployment (recommended): put the files in
# ./downloads as Francesca.exe / Francesca.dmg / Francesca, then set
# this. They are offered at /public/download/<platform> on your own domain,
# which works on networks that cannot reach GitHub's asset CDN, and the
# checksums are computed for you.
DOWNLOAD_DIR=
DOWNLOAD_VERSION=
# ...or link to an external host instead. A local file wins if both are set.
DOWNLOAD_WINDOWS=
DOWNLOAD_WINDOWS_SHA256=
DOWNLOAD_MAC=
DOWNLOAD_MAC_SHA256=
DOWNLOAD_LINUX=
DOWNLOAD_LINUX_SHA256=
