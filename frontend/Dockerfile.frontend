# Francesca frontend image (Next.js, standalone output)

# 1. Install dependencies (incl. devDeps needed to build)
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install

# 2. Build the app
FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# NEXT_PUBLIC_* values are inlined at build time. Defaults in code point at
# http://localhost:8000, which is correct for the browser in a local setup.
# docker-compose passes https://francesca.dpdns.org/api for the public site.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
# Desktop build URLs. Leave unset and the landing page hides the section
# rather than offering a dead link.
ARG NEXT_PUBLIC_DOWNLOAD_WINDOWS
ARG NEXT_PUBLIC_DOWNLOAD_MAC
ARG NEXT_PUBLIC_DOWNLOAD_LINUX
RUN npm run build

# 3. Minimal runtime image serving the standalone server
FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# Standalone output bundles only what's needed to run `node server.js`.
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

# Non-root (the node user ships with the base image)
USER node

EXPOSE 3000
CMD ["node", "server.js"]
