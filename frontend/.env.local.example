NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: enables the "Sign in with Google" button. Must match GOOGLE_CLIENT_ID
# configured on the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: URLs of the desktop builds offered on the landing page.
# Leave empty to hide the download section.
NEXT_PUBLIC_DOWNLOAD_WINDOWS=
NEXT_PUBLIC_DOWNLOAD_MAC=
NEXT_PUBLIC_DOWNLOAD_LINUX=

# Optional: where universities, Law Clinics and white-label partners can
# reach you from the pricing section. Without it the buttons point to the
# lawyer section of the page.
NEXT_PUBLIC_CONTACT_EMAIL=
