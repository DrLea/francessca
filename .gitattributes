# Keep shell scripts LF, always. A CRLF shebang makes Linux containers
# fail with: env: 'bash\r': No such file or directory
*.sh text eol=lf
entrypoint.sh text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
# Windows PowerShell 5.1 wants CRLF and a BOM; keep git from
# normalising these to LF on checkout.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
